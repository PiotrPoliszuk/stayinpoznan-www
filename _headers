/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: DENY

/assets/images/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*.css
  Cache-Control: public, max-age=86400

/assets/*.js
  Cache-Control: public, max-age=86400

# Never index the production pages.dev hostname or public deployment previews.
https://stayinpoznan-www.pages.dev/*
  X-Robots-Tag: noindex

https://:version.stayinpoznan-www.pages.dev/*
  X-Robots-Tag: noindex

# PZN static preview WEB-2026-000002
https://content-factory-web-2026-000002.stayinpoznan-www.pages.dev/*
  ! X-Frame-Options
  Content-Security-Policy: frame-ancestors https://appfactory.pzn.me https://mission.pzn.me;
  X-Robots-Tag: noindex
